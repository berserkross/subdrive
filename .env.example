# SubDrive 环境变量样例 —— 复制为 .env 后填写，.env 已被 .gitignore 忽略。
# 令牌只经服务器上 chmod 600 的 env 文件注入，永不写进仓库、不入聊天记录。

# 运行数据根目录（SQLite + stub 存储），Docker 内为 /data
DATA_DIR=./data

# stub = 本地文件系统假实现（默认，不联网）；live = 真实 Seafile Web API v2
SEAFILE_MODE=stub

# live 模式三项（stub 模式留空即可）
SEAFILE_BASE_URL=
SEAFILE_API_TOKEN=
SEAFILE_REPO_ID=
SEAFILE_REPO_NAME=subdrive

# 首次启动初始化管理员（不填则首个注册用户自动成为管理员）
SUBDRIVE_ADMIN_USERNAME=
SUBDRIVE_ADMIN_PASSWORD=

# 配额与限额
DEFAULT_QUOTA_BYTES=21474836480
MAX_FILE_BYTES=2147483648
SPEEDTEST_MAX_BYTES=52428800
SESSION_TTL_DAYS=30
LOGIN_MAX_FAILS=5
LOGIN_LOCK_MINUTES=10
CALIBRATE_INTERVAL_SECONDS=3600
